{% assign title = post.frontmatter.metatitle | default: post.title | default: blog.title %}
{% assign description = post.frontmatter.metadescription | default: post.description | default: blog.description %}
{% assign canonical = post.canonical | default: template.domain %}
{% if post.thumb.jpeg %}
  {% assign thumb_url = template.domain | append: post.thumb.jpeg %}
{% else %}
  {% assign thumb_url = '' %}
{% endif %}
{% assign thumb_alt = post.thumb.legend | default: post.thumb_legend | default: title %}
<!doctype html>
<html lang="fr" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | escape }}</title>
  <meta name="description" content="{{ description | escape }}">
  <meta name="author" content="{{ blog.author | escape }}">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <meta name="theme-color" content="#db4b2f">
  <link rel="canonical" href="{{ canonical }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ blog.title }}" href="/feeds/feed.xml">
  {% if post.frontmatter.layout == "diaporama" %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIINfQ3ynhOtRZkZs5DloXjR+FF9Ff0kBMo=" crossorigin="">
  <link rel="stylesheet" href="/assets/css/diaporama.css?ver={{ blog.version }}">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="/assets/js/diaporama.js?ver={{ blog.version }}" defer></script>
  {% endif %}
  <meta property="og:title" content="{{ title | escape }}">
  <meta property="og:description" content="{{ description | escape }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="{% if post.type == 0 %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ blog.title | escape }}">
  <meta property="og:locale" content="fr_FR">
  {% if post.type == 0 and post.pub_date_str %}<meta property="article:published_time" content="{{ post.pub_date_str }}">{% endif %}
  {% if post.type == 0 and post.pub_update_str %}<meta property="article:modified_time" content="{{ post.pub_update_str }}">{% endif %}
  {% if thumb_url %}
  <meta property="og:image" content="{{ thumb_url }}">
  <meta property="og:image:secure_url" content="{{ thumb_url }}">
  <meta property="og:image:type" content="image/jpeg">
  {% if post.thumb.width %}<meta property="og:image:width" content="{{ post.thumb.width }}">{% endif %}
  {% if post.thumb.height %}<meta property="og:image:height" content="{{ post.thumb.height }}">{% endif %}
  <meta property="og:image:alt" content="{{ thumb_alt | string | escape }}">
  {% endif %}
  <meta name="twitter:card" content="{% if thumb_url %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ title | escape }}">
  <meta name="twitter:description" content="{{ description | escape }}">
  {% if thumb_url %}
  <meta name="twitter:image" content="{{ thumb_url }}">
  <meta name="twitter:image:alt" content="{{ thumb_alt | string | escape }}">
  {% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": {% if post.is_home %}"WebSite"{% elsif post.type == 0 %}"Article"{% else %}"WebPage"{% endif %},
    "@id": {{ canonical | append: "#primary" | tojson }},
    "url": {{ canonical | tojson }},
    "name": {{ title | tojson }},
    "description": {{ description | tojson }},
    "inLanguage": "fr-FR",
    "publisher": {
      "@type": "Organization",
      "name": {{ blog.title | tojson }},
      "url": {{ template.domain | tojson }}
    }{% if post.type == 0 %},
    "author": {
      "@type": "Person",
      "name": {{ blog.author | tojson }},
      "url": {{ blog.author_url | default: template.domain | tojson }}
    }{% if post.pub_date_str %},
    "datePublished": {{ post.pub_date_str | tojson }}{% endif %}{% if post.pub_update_str %},
    "dateModified": {{ post.pub_update_str | tojson }}{% endif %}{% endif %}{% if thumb_url %},
    "image": {{ thumb_url | tojson }}{% endif %}
  }
  </script>
  <style>{{ template.inlinecss }}</style>
  {% if template.inlinejs %}<script>{{ template.inlinejs }}</script>{% endif %}
</head>
<body class="{% if post.type == 4 %}route-page{% elsif post.is_home %}home-page{% else %}content-page{% endif %}">
<a class="skip-link" href="#content">Aller au contenu</a>
<header class="site-header{% if post.is_home %} home-header{% endif %}">
  {% unless post.is_home %}
  <a class="brand" href="/" aria-label="727 Bikepacking — Accueil">
    <img src="/assets/img/727logo_horizontal_noir.svg" alt="727 Bikepacking">
  </a>
  {% endunless %}
  <nav class="site-nav" aria-label="Navigation principale">
    {% for item in blog.header_menu %}<a href="{{ item.url }}">{{ item.title }}</a>{% endfor %}
    <a class="nav-menu" href="#footer-navigation">Menu</a>
  </nav>
</header>
<main id="content">
