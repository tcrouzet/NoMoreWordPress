<div>
{% if post.substack_url and post.substack_url.size>0 %}
  {% comment %} {% assign comments = post.substack_url | append: "/comments" %} {% endcomment %}
  <a href="{{ post.substack_url }}/comments">Commenter</a>
  {% comment %} {% assign shareurl = post.substack_url | append: "?utm_source=substack&utm_medium=email&utm_content=share&action=share" %} {% endcomment %}
  <a href="{{ post.substack_url }}?utm_source=substack&utm_medium=email&utm_content=share&action=share">Partager</a>

  {% assign parts = post.substack_url | split: "/" %}
  {% assign subscribe = parts[0] | append: "//" | append: parts[2] | append: "/subscribe" %}
  <a href="{{ subscribe }}">S’abonner</a>

{% else %}
  <a href="/page/abonnement-par-mail/">S’abonner</a>
{% endif %}
</div>