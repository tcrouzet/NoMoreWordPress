{% assign title = post.frontmatter.metatitle | default: post.title | default: blog.title %}
{% assign description = post.frontmatter.metadescription | default: post.description | default: blog.description %}
{% if post.thumb.jpeg %}
  {% set thumb_url = template.domain.rstrip('/') + post.thumb.jpeg %}
{% else %}
  {% set thumb_url = '' %}
{% endif %}

{% assign current_carnets = false %}
{% assign current_velo = false %}
{% assign current_blog = false %}
{% assign current_books = false %}

{% set current_tag_slug = post.get('tag_slug', '') %}
{% set current_post_type = post.get('type') %}
{% set current_navigation = post.get('navigation') or {} %}
{% set current_navigation_slug = current_navigation.get('slug', '') %}
{% set current_navigation_title = current_navigation.get('title', '') %}

{% if current_tag_slug == "carnets" or current_navigation_slug == "carnets" or current_navigation_title == "Carnets" %}
  {% assign current_carnets = true %}
{% endif %}
{% if current_tag_slug == "velo" or current_navigation_slug == "velo" or current_navigation_title == "Vélo" %}
  {% assign current_velo = true %}
{% endif %}
{% if current_tag_slug == "blog" or current_post_type == 0 %}
  {% assign current_blog = true %}
{% endif %}
{% if current_tag_slug == "book" or current_post_type == 2 %}
  {% assign current_books = true %}
{% endif %}

{% if current_carnets or current_velo %}
  {% assign current_blog = false %}
{% endif %}

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% if template.inlinecss %}<style>{{ template.inlinecss }}{% if post.css %}{{ post.css }}{% endif %}</style>{% endif %}
    <title>{{ title }}</title>
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="alternate" type="application/rss+xml" title="Thierry Crouzet" href="/feeds/feed.xml" />

    <meta name='robots' content='index, follow' />
    <meta name="google-site-verification" content="EmtKKbIk2-Tz3Nyp7hJRPjcMbgf68Vwq6yJYs1hvsqA" />
    <meta name="msvalidate.01" content="805E5BFBA891A41968028F5C97A228D3" />
    <meta name="description" content="{{ description }}" />
    <meta name="author" content="{{ blog.title }}" />
    <link rel="canonical" href="{{ post.canonical }}" />
    <link rel="human-json" href="/human.json" />

    <link rel="me" href="https://mamot.fr/@tcrouzet">
    <meta name="fediverse:creator" content="@tcrouzet@mamot.fr">
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="{{ post.canonical }}" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="{{ blog.title }}" />
    <meta property="article:author" content="{{ blog.author }}" />
    <meta property="article:published_time" content="{{ post.pub_date_str }}" />
    <meta property="article:modified_time" content="{{ post.pub_update_str }}" />
    <meta property="og:image" content="{{ thumb_url }}" />
    <meta property="og:image:width" content="{{ post.thumb.width }}" />
    <meta property="og:image:height" content="{{ post.thumb.height }}" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property=og:image:alt content="{{ post.thumb_legend }}">
    <meta name=twitter:card content=summary_large_image>
    <meta name=twitter:image content="{{ thumb_url }}">
    <meta name=twitter:title content="{{ title }}">
    <meta name=twitter:description content="{{ description }}">

</head>

{% if blog.analytics %}
<script async src="https://www.googletagmanager.com/gtag/js?id=G-47YLN2LHVB"></script>
<script data-cfasync=”false”>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-47YLN2LHVB');
</script>
{% endif %}

<body>

<header>

  {% if not post.is_home %}
    <a href="/" aria-label="Top"></a>
  {% endif %}

  <a href="/page/informations/" aria-label="Informations">
    <img src="/assets/portrait.webp" alt="Thierry Crouzet">
  </a>

  {% if post.is_home %}
    <span aria-label="Accueil">Thierry <b>Crouzet</b></span>
  {% else %}
    <a href="/" aria-label="Accueil">Thierry <b>Crouzet</b></a>
  {% endif %}

  <a href="/search/" aria-label="Recherche"></a>

  <nav aria-label="Navigation principale">
    <a href="/"{% if post.is_home %} aria-current="page"{% endif %}>Accueil</a>
    <a href="/blog/"{% if current_blog %} aria-current="page"{% endif %}>Digressions</a>
    <a href="/carnet-de-route/"{% if current_carnets %} aria-current="page"{% endif %}>Carnets</a>
    <a href="/borntobike/"{% if current_velo %} aria-current="page"{% endif %}>Vélo</a>
    <a href="/bibliographie/"{% if current_books %} aria-current="page"{% endif %}>Livres</a>
  </nav>
</header>